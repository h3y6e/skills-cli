{{- $card := add .RulerY 78 -}}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 {{$card}}" width="900" height="{{$card}}" role="img" aria-labelledby="t d">
  <title id="t">Time to update installed skills</title>
  <desc id="d">{{.Readout}}. Median wall time of {{.Runs}} runs on {{.Env}} with {{.Versions}}; a first run starts from an empty cache, a repeat run from the cache the first one filled.{{range .Groups}}{{$g := .Title}}{{range .Bars}}
{{$g}}, {{.Tool}}: {{secs .Warm}} repeat run, {{secs .Cold}} first run{{end}}{{end}}
</desc>
  <style>
    {{template "style"}}
    .value { fill: #18181a; }
    .skolar { fill: #2a78d6; }
    .other { fill: #86868a; }
    @media (prefers-color-scheme: dark) {
      .value { fill: #e6e6e6; }
      .skolar { fill: #3987e5; }
      .other { fill: #76767a; }
    }
  </style>
  <rect class="card" x=".5" y=".5" width="899" height="{{sub $card 1}}"/>
  <text class="corner" x="34" y="44">{{.Versions}}</text>
  <text class="corner" x="806" y="44" text-anchor="end">REPEAT</text>
  <text class="corner" x="866" y="44" text-anchor="end">FIRST</text>
{{- range .Shown}}
  <text class="h" x="34" y="{{.Y}}">{{.Title}}</text>
{{- range .Bars}}
  <text class="mono" x="34" y="{{add .Y 10}}">{{.Tool}}</text>
  <rect class="band" x="{{axisX}}" y="{{.Y}}" width="{{.ColdW}}" height="12" rx="3"/>
  <rect class="{{if .Skolar}}skolar{{else}}other{{end}}" x="{{axisX}}" y="{{.Y}}" width="{{.WarmW}}" height="12" rx="3"/>
  <text class="mono{{if .Skolar}} value{{end}}" x="806" y="{{add .Y 10}}" text-anchor="end">{{secs .Warm}}</text>
  <text class="mono muted" x="866" y="{{add .Y 10}}" text-anchor="end">{{secs .Cold}}</text>
{{- end}}
{{- end}}
  <line class="rule" x1="{{axisX}}" x2="{{add axisX axisW}}" y1="{{.RulerY}}" y2="{{.RulerY}}"/>
{{- range .Ticks}}
  <path class="rule" d="M {{.X}} {{$.RulerY}} V {{add $.RulerY (tickLen .Label)}}"/>{{if .Label}}<text class="mono muted" x="{{.X}}" y="{{add $.RulerY 22}}" text-anchor="middle">{{.Label}}</text>{{end}}
{{- end}}
  <g transform="translate(34 {{sub $card 24}})">
    <rect class="skolar" width="12" height="12" rx="3" y="-10"/><text class="corner" x="18">SKOLAR</text>
    <rect class="other" width="12" height="12" rx="3" y="-10" x="96"/><text class="corner" x="114">OTHER TOOL</text>
    <rect class="band" width="12" height="12" rx="3" y="-10" x="214"/><text class="corner" x="232">FIRST RUN</text>
  </g>
  <text class="corner" x="866" y="{{sub $card 24}}" text-anchor="end">{{.Platform}}</text>
</svg>
